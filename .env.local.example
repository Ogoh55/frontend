# ---------------------------------------------------------------------------
# Zenith environment configuration (local development)
# Copy to `.env.local` and fill in real values. Never commit `.env.local`.
# ---------------------------------------------------------------------------

# Public base URL of the app (used for OAuth callbacks, anchor redirects, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stellar network: "testnet" | "mainnet"
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Soroban RPC / Horizon endpoints
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org

# ---------------------------------------------------------------------------
# Fiat on-ramp / off-ramp (SEP-24 interactive, SEP-6 non-interactive)
#
# Anchor endpoints are configured per network. Leave a network's anchor URL
# blank to disable fiat on/off-ramp for that network — the "Fund from bank"
# and "Cash out" entry points are hidden when no anchor is configured.
#
# Anchor credentials are server-side only (used by the BFF proxy at
# /api/anchor/*). Do NOT prefix these with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# --- Testnet anchor ---
ANCHOR_TESTNET_HOME_DOMAIN=
ANCHOR_TESTNET_SEP24_URL=
ANCHOR_TESTNET_SEP6_URL=
ANCHOR_TESTNET_SIGNING_KEY=

# --- Mainnet anchor ---
ANCHOR_MAINNET_HOME_DOMAIN=
ANCHOR_MAINNET_SEP24_URL=
ANCHOR_MAINNET_SEP6_URL=
ANCHOR_MAINNET_SIGNING_KEY=

# Assets the configured anchor supports for fiat on/off-ramp (comma-separated
# asset codes, e.g. "USDC"). Used to gate the entry points per selected asset.
ANCHOR_SUPPORTED_ASSETS=USDC
